{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "lsp": true,
  "disabled_providers": [
    "openai",
    "mistral",
    "requesty"
  ],
  "mcp": {
    "tavily": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tavily-mcp@latest"
      ]
    },
    "Context7": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  },
  "plugin": [
    "~/.config/opencode/plugins/graphify.js"
  ]
}
